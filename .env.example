# Live LLM provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional price override for models not in the built-in benchmark table
OPENAI_INPUT_COST_PER_1M=
OPENAI_OUTPUT_COST_PER_1M=
PROVIDER_MAX_RETRIES=3

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=multi-agent-research-lab
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed when one API key is linked to multiple workspaces
LANGSMITH_WORKSPACE_ID=

# Tavily search
TAVILY_API_KEY=

# Runtime config
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
